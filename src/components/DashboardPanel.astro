              <span style="display: flex; align-items: baseline; gap: 5px; font-family: 'IBM Plex Mono',monospace; font-size: 22px; font-weight: 500; line-height: 1; color: #F87171">23</span>
              <span style="font-size: 10.5px; color: rgba(255,255,255,0.38)">16% del total</span>
              <svg viewBox="0 0 100 22" preserveAspectRatio="none" style="width: 100%; height: 22px; margin-top: auto"><polyline points="0,18 14,16 28,17 42,12 56,13 70,8 85,6 100,3" fill="none" stroke="#F87171" stroke-width="1.6" vector-effect="non-scaling-stroke"></polyline></svg>
            </div>
            <div style="border-radius: 12px; border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.025); padding: 10px 12px; display: flex; flex-direction: column; gap: 6px; min-width: 0">
              <span style="display: flex; align-items: center; gap: 7px; font-size: 11px; color: rgba(255,255,255,0.55); white-space: nowrap; overflow: hidden; text-overflow: ellipsis"><span style="width: 11px; height: 11px; border-radius: 3px; border: 1.3px solid currentColor; flex-shrink: 0"></span>Kilómetros analizados</span>
              <span style="display: flex; align-items: baseline; gap: 5px; font-family: 'IBM Plex Mono',monospace; font-size: 22px; font-weight: 500; line-height: 1; color: #fff">35.7<span style="font-size: 12px; color: rgba(255,255,255,0.45)">km</span></span>
