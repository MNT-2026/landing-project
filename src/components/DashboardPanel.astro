                <span style="width: 14px; height: 14px; border-radius: 4px; border: 1.4px solid currentColor; opacity: 0.55; flex-shrink: 0"></span>
                <span style="flex-grow: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">Datos</span>
                
