            </div>
            <div style="border-radius: 12px; border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.025); padding: 10px 12px; display: flex; flex-direction: column; gap: 6px; min-width: 0">
              <span style="display: flex; align-items: center; gap: 7px; font-size: 11px; color: rgba(255,255,255,0.55); white-space: nowrap; overflow: hidden; text-overflow: ellipsis"><span style="width: 11px; height: 11px; border-radius: 3px; border: 1.3px solid currentColor; flex-shrink: 0"></span>Grietas</span>
