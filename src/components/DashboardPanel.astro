              <svg viewBox="0 0 100 22" preserveAspectRatio="none" style="width: 100%; height: 22px; margin-top: auto"><polyline points="0,18 14,16 28,17 42,12 56,13 70,8 85,6 100,3" fill="none" stroke="#3D81E3" stroke-width="1.6" vector-effect="non-scaling-stroke"></polyline></svg>
            </div>
