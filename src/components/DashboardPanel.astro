                <span style="width: 28px; height: 28px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.09); display: flex; align-items: center; justify-content: center; position: relative"><span style="width: 9px; height: 9px; border-radius: 3px 3px 0 0; border: 1.3px solid rgba(255,255,255,0.5)"></span><span style="position: absolute; top: 5px; right: 5px; width: 5px; height: 5px; border-radius: 50%; background: #F87171"></span></span>
                <span class="dash-toolbar-user" style="display: flex; align-items: center; gap: 8px; padding-left: 4px"><span style="width: 28px; height: 28px; border-radius: 50%; background: #2563EB; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700">SM</span><span style="line-height: 1.2"><span style="display: block; font-size: 11.5px; font-weight: 600">Sofía Marín</span><span style="display: block; font-size: 9.5px; color: rgba(255,255,255,0.42)">Administrador</span></span></span>
              </div>
            </div>

            <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding: 12px 16px">
