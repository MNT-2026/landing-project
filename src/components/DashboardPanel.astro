                <span style="line-height: 1.2"><span style="display: block; font-size: 12px; font-weight: 600">Sofía Marín</span><span style="display: block; font-size: 10px; color: rgba(255,255,255,0.42)">Rol: Administrador</span></span>
              </div>
              <span style="display: block; font-family: 'IBM Plex Mono',monospace; font-size: 9px; letter-spacing: 0.18em; color: rgba(255,255,255,0.3); margin: 14px 0 7px">TEMA</span>
