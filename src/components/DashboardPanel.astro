              <img src="/logo-simav-mark.png" alt="" style="height: 26px; width: auto; display: block">
              <span style="line-height: 1.15"><span style="display: block; font-size: 13px; font-weight: 800; letter-spacing: 0.06em">SIMAV VIAL</span><span style="display: block; font-family: 'IBM Plex Mono',monospace; font-size: 8px; letter-spacing: 0.18em; color: rgba(255,255,255,0.4)">ROAD INTELLIGENCE</span></span>
            </div>
            <div style="padding: 10px 10px; display: flex; flex-direction: column; gap: 2px">
              <span style="font-family: 'IBM Plex Mono',monospace; font-size: 9px; letter-spacing: 0.18em; color: rgba(255,255,255,0.3); padding: 4px 11px">OPERACIÓN</span>
