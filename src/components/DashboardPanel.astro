            <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding: 12px 16px; border-bottom: 1px solid rgba(255,255,255,0.07)">
              <span style="width: 26px; height: 22px; border-radius: 5px; border: 1.4px solid rgba(255,255,255,0.2)"></span>
              <span style="line-height: 1.2">
                <span style="display: block; font-size: 10.5px; color: rgba(255,255,255,0.4)">Inicio &nbsp;›&nbsp; Dashboard</span>
                <span style="display: block; font-size: 16px; font-weight: 700; letter-spacing: -0.015em">Dashboard operativo</span>
              </span>
