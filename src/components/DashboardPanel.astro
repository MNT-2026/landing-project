                <span class="dsh-10" style="flex-grow: 1; text-align: center; font-size: 10.5px; padding: 6px 4px; border-radius: 7px; color: rgba(255,255,255,0.5); cursor: pointer; transition: all 0.15s">Dark</span>
                <span style="flex-grow: 1; text-align: center; font-size: 10.5px; padding: 6px 4px; border-radius: 7px; background: #2563EB; color: #fff; font-weight: 600">Night</span>
              </div>
            </div>
          </aside>

