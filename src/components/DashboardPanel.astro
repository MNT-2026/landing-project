              <div style="margin-left: auto; display: flex; gap: 9px">
                <button class="dsh-11" type="button" style="display: inline-flex; align-items: center; gap: 7px; font-size: 11.5px; font-weight: 500; padding: 8px 13px; border-radius: 9px; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.03); color: rgba(255,255,255,0.8); cursor: pointer; transition: all 0.18s">Actualizar</button>
