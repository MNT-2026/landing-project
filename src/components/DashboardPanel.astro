                <span style="width: 14px; height: 14px; border-radius: 4px; border: 1.4px solid currentColor; opacity: 0.95; flex-shrink: 0"></span>
                <span style="flex-grow: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">Dashboard</span>
                
              </div>
              <div class="dsh-1" style="display: flex; align-items: center; gap: 10px; padding: 6px 11px; border-radius: 8px; color: rgba(255,255,255,0.58); font-size: 12.5px; font-weight: 500; cursor: pointer; transition: all 0.15s">
                <span style="width: 14px; height: 14px; border-radius: 4px; border: 1.4px solid currentColor; opacity: 0.55; flex-shrink: 0"></span>
                <span style="flex-grow: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">Mapa</span>
                
              </div>
              <div class="dsh-2" style="display: flex; align-items: center; gap: 10px; padding: 6px 11px; border-radius: 8px; color: rgba(255,255,255,0.58); font-size: 12.5px; font-weight: 500; cursor: pointer; transition: all 0.15s">
                <span style="width: 14px; height: 14px; border-radius: 4px; border: 1.4px solid currentColor; opacity: 0.55; flex-shrink: 0"></span>
                <span style="flex-grow: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">Incidentes</span>
                <span style="font-family: 'IBM Plex Mono',monospace; font-size: 10.5px; color: rgba(255,255,255,0.4)">46</span>
              </div>
