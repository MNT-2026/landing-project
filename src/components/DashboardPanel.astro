                <span style="flex-grow: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">Cámaras</span>
                <span style="font-family: 'IBM Plex Mono',monospace; font-size: 10.5px; color: rgba(255,255,255,0.4)">8/10</span>
              </div>
