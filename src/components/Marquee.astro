---
import { MARQUEE } from '../data/team';
/* Franja con mensajes en movimiento continuo + reloj en vivo. */
const items = [...MARQUEE, ...MARQUEE];
---

<div class="strip">
  <div class="strip__mark">
    <img src="/logo-simav-mark.png" alt="" width="18" height="18" />
    SIMAV VIAL
  </div>

  <div class="strip__viewport">
    <div class="strip__track">
      {items.map((it) => (
        <span class="strip__item">
          <span class="strip__label">
            <span class="strip__dot" style={{ background: it.dot }}></span>
            {it.text}
          </span>
          <span class="strip__sep">/</span>
        </span>
      ))}
    </div>
  </div>

  <div class="strip__clock">
    <span class="strip__pulse"></span>
    <span data-clock>--/--/---- --:--:--</span>
  </div>
</div>

<style>
  .strip {
    width: 100%;
    height: 44px;
    background: rgba(6,8,12,0.75);
    backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255,255,255,0.1);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    overflow: hidden;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
  }
  .strip__mark {
    display: flex; align-items: center; gap: 10px; padding: 0 16px; height: 100%;
    flex-shrink: 0; border-right: 1px solid rgba(255,255,255,0.1); color: #fff; white-space: nowrap;
  }
  .strip__mark img { height: 18px; width: auto; display: block; }
  .strip__viewport {
    position: relative; flex-grow: 1; overflow: hidden; height: 100%;
    display: flex; align-items: center;
    mask-image: linear-gradient(to right, transparent 0, #000 5%, #000 95%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 5%, #000 95%, transparent 100%);
  }
  .strip__track {
    display: flex; align-items: center; gap: 22px; white-space: nowrap;
    will-change: transform; animation: marquee 42s linear infinite;
  }
  .strip__item { display: flex; align-items: center; gap: 22px; flex-shrink: 0; }
  .strip__label { display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.72); }
  .strip__dot { width: 5px; height: 5px; border-radius: 50%; }
  .strip__sep { color: rgba(255,255,255,0.18); }
  .strip__clock {
    display: flex; align-items: center; gap: 8px; padding: 0 16px; height: 100%;
    flex-shrink: 0; border-left: 1px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.7); white-space: nowrap;
  }
  .strip__pulse { width: 5px; height: 5px; border-radius: 50%; background: #00D2FF; animation: pulseDot 2s ease-in-out infinite; }

  @media (max-width: 720px) {
    .strip__clock { display: none; }
    .strip__mark { padding: 0 12px; font-size: 10px; }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-clock]');
  if (el) {
    const p = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      const d = new Date();
      el.textContent = `${p(d.getDate())}/${p(d.getMonth() + 1)}/${d.getFullYear()} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
    };
    tick();
    setInterval(tick, 1000);
  }
</script>
