---
/* Fondo fijo de la página: retícula en perspectiva, banda de escaneo y viñeta.
   Incluye los filtros SVG de ruido usados por el degradado del titular. */
---

<svg aria-hidden="true" style="position: absolute; width: 0; height: 0; overflow: hidden">
  <filter id="c3-noise">
    <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" stitchTiles="stitch"></feTurbulence>
    <feColorMatrix type="saturate" values="0"></feColorMatrix>
    <feComponentTransfer><feFuncA type="linear" slope="0.14"></feFuncA></feComponentTransfer>
    <feComposite operator="in" in2="SourceGraphic"></feComposite>
    <feBlend in2="SourceGraphic" mode="multiply"></feBlend>
  </filter>
</svg>

<div
  aria-hidden="true"
  style="position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; background: #08090C"
>
  <div style="position: absolute; inset: 0; background: radial-gradient(90% 60% at 50% -10%, rgba(11,37,81,0.55) 0%, rgba(8,9,12,0) 65%), radial-gradient(70% 50% at 85% 110%, rgba(0,210,255,0.10) 0%, rgba(8,9,12,0) 70%)"></div>
  <div style="position: absolute; left: -10%; right: -10%; bottom: -14%; height: 78%; transform: perspective(620px) rotateX(66deg); transform-origin: 50% 100%; background-image: linear-gradient(rgba(61,129,227,0.16) 1px, transparent 1px), linear-gradient(90deg, rgba(61,129,227,0.12) 1px, transparent 1px); background-size: 100% 64px, 64px 100%; mask-image: linear-gradient(to top, #000 0%, rgba(0,0,0,0.25) 55%, transparent 100%); -webkit-mask-image: linear-gradient(to top, #000 0%, rgba(0,0,0,0.25) 55%, transparent 100%)"></div>
  <div style="position: absolute; left: 0; right: 0; height: 38%; top: -38%; background: linear-gradient(to bottom, transparent 0%, rgba(0,210,255,0.055) 55%, rgba(0,210,255,0.11) 82%, transparent 100%); animation: scanSweep 14s linear infinite"></div>
  <div style="position: absolute; inset: 0; background-image: repeating-linear-gradient(to bottom, rgba(255,255,255,0.022) 0 1px, transparent 1px 3px)"></div>
  <div style="position: absolute; inset: 0; background: radial-gradient(120% 80% at 50% 50%, transparent 40%, rgba(6,7,10,0.75) 100%)"></div>
</div>
