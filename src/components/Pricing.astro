---
import { PLANS, DEFAULT_PLAN } from '../data/plans';

/* Selector de plan + una única tarjeta de detalle (precio, rangos y características). */
---

<section id="precios" class="plans">
  <div class="plans__head">
    <h2 class="plans__title">Modelos de vinculación</h2>
    <p class="plans__lede">
      Cada modelo se cotiza según los kilómetros de red vial e incluye implementación inicial más la
      suscripción anual de uso, alojamiento, actualizaciones, mantenimiento y soporte.
    </p>
  </div>

  <div class="plans__grid">
    <div class="plans__picker" role="radiogroup" aria-label="Tipo de plan">
      <span class="plans__step">1 · ELIGE EL TIPO DE PLAN</span>
      {PLANS.map((p, i) => (
        <button
          type="button"
          class="plans__option"
          role="radio"
          aria-checked={i === DEFAULT_PLAN ? 'true' : 'false'}
          data-plan-btn={String(i)}
          data-on={i === DEFAULT_PLAN ? 'true' : 'false'}
        >
          <span class="plans__radio"></span>
          <span class="plans__optiontext">
            <span class="plans__optiontag">{p.tag}</span>
            <span class="plans__optiontitle">{p.title}</span>
            <span class="plans__optionsub">{p.short}</span>
          </span>
        </button>
      ))}
    </div>

    <div class="plans__detail">
      {PLANS.map((p, i) => (
        <article class="plans__panel" data-plan-panel={String(i)} data-on={i === DEFAULT_PLAN ? 'true' : 'false'}>
          <div>
            <span class="plans__paneltag">{p.tag}</span>
            <h3 class="plans__paneltitle">{p.title}</h3>
            <p class="plans__panelsub">{p.sub}</p>
          </div>

          <div class="plans__prices">
            {p.prices.map((price) => (
              <div class="plans__price">
                <span class="plans__pricekicker"><span class="plans__pricedot"></span>{price.kicker}</span>
                <span class="plans__priceamount">
                  <strong>{price.amount}</strong>
                  {price.unit && <span class="plans__priceunit">{price.unit}</span>}
                </span>
                <span class="plans__pricenote">{price.note}</span>
              </div>
            ))}
          </div>

          {p.ranges && (
            <div>
              <span class="plans__label">ESCALONADO POR KILÓMETROS</span>
              <div class="plans__ranges">
                {p.ranges.map((r) => (
                  <div class="plans__range">
                    <span class="plans__rangekm">{r.km}</span>
                    <span class="plans__rangeval">{r.val}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <div>
            <span class="plans__label">CARACTERÍSTICAS PRINCIPALES</span>
            <ul class="plans__features">
              {p.features.map((f) => (
                <li><span class="plans__bullet"></span>{f}</li>
              ))}
            </ul>
          </div>

          <a href="#contacto" class="plans__cta">{p.cta}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .plans { position: relative; max-width: 1152px; margin: 0 auto; padding: clamp(48px, 7vw, 110px) 24px; }
  .plans__head { position: relative; text-align: center; margin-bottom: 44px; }
  .plans__title { margin: 0; font-size: clamp(26px, 3.6vw, 44px); font-weight: 700; letter-spacing: -0.03em; }
  .plans__lede { margin: 16px auto 0; max-width: 600px; font-size: 13.5px; line-height: 1.6; color: rgba(255,255,255,0.55); }

  .plans__grid {
    position: relative; display: grid; gap: 20px; align-items: start;
    grid-template-columns: minmax(280px, 0.8fr) minmax(320px, 1.2fr);
  }
  .plans__picker { display: flex; flex-direction: column; gap: 12px; }
  .plans__step { font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; letter-spacing: 0.16em; color: rgba(255,255,255,0.45); }

  .plans__option {
    position: relative; text-align: left; cursor: pointer; padding: 20px 22px;
    border-radius: 26px; border: 1px solid rgba(255,255,255,0.1);
    background: rgba(12,14,18,0.7); color: #fff;
    display: flex; align-items: center; gap: 16px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);
    transition: border-color 0.35s, background 0.35s, transform 0.35s cubic-bezier(0.2,0.8,0.2,1), box-shadow 0.35s;
  }
  .plans__option:hover { border-color: rgba(0,210,255,0.6); transform: translateY(-3px); }
  .plans__option:focus-visible { outline: 2px solid rgba(0,210,255,0.7); outline-offset: 3px; }
  .plans__option[data-on='true'] {
    border-color: rgba(0,210,255,0.7);
    background: rgba(11,37,81,0.55);
    box-shadow: 0 22px 60px -34px rgba(0,210,255,0.8), inset 0 1px 0 rgba(255,255,255,0.14);
  }
  .plans__radio {
    flex-shrink: 0; width: 12px; height: 12px; border-radius: 50%;
    border: 1px solid rgba(0,210,255,0.55); background: transparent;
    transition: background 0.3s, box-shadow 0.3s;
  }
  .plans__option[data-on='true'] .plans__radio { background: #00D2FF; box-shadow: 0 0 12px rgba(0,210,255,0.8); }
  .plans__optiontext { display: flex; flex-direction: column; gap: 5px; }
  .plans__optiontag { font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; letter-spacing: 0.14em; color: #7FE6FF; }
  .plans__optiontitle { font-size: 16.5px; font-weight: 700; letter-spacing: -0.02em; }
  .plans__optionsub { font-size: 12px; line-height: 1.5; color: rgba(255,255,255,0.5); }

  .plans__detail { position: relative; }
  .plans__panel {
    display: none; flex-direction: column; gap: 18px;
    border-radius: 44px; border: 1px solid rgba(0,210,255,0.35);
    background: rgba(11,37,81,0.4); backdrop-filter: blur(14px);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.12), 0 30px 90px -50px rgba(0,210,255,0.6);
    padding: 32px 28px;
  }
  .plans__panel[data-on='true'] { display: flex; animation: riseIn 0.45s ease-out both; }
  .plans__paneltag { font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; letter-spacing: 0.14em; color: #7FE6FF; }
  .plans__paneltitle { margin: 8px 0 0; font-size: 22px; font-weight: 700; letter-spacing: -0.02em; }
  .plans__panelsub { margin: 10px 0 0; font-size: 12.5px; line-height: 1.6; color: rgba(255,255,255,0.55); }

  .plans__prices { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .plans__price {
    display: flex; flex-direction: column; gap: 6px; padding: 16px 18px;
    border-radius: 20px; border: 1px solid rgba(0,210,255,0.28); background: rgba(0,210,255,0.07);
  }
  .plans__pricekicker {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; letter-spacing: 0.16em; color: #9FEBFF;
  }
  .plans__pricedot { width: 5px; height: 5px; border-radius: 50%; background: #00D2FF; }
  .plans__priceamount { display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }
  .plans__priceamount strong { font-size: clamp(22px, 2.4vw, 27px); font-weight: 800; letter-spacing: -0.03em; color: #fff; }
  .plans__priceunit { font-size: 12px; color: rgba(255,255,255,0.55); }
  .plans__pricenote { font-size: 10.5px; color: rgba(255,255,255,0.45); }

  .plans__label { font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; letter-spacing: 0.16em; color: rgba(255,255,255,0.5); }
  .plans__ranges { margin-top: 8px; }
  .plans__range {
    display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
    padding: 9px 0; border-top: 1px solid rgba(255,255,255,0.07);
  }
  .plans__rangekm { font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.88); }
  .plans__rangeval { font-size: 11px; text-align: right; color: rgba(255,255,255,0.55); }

  .plans__features {
    margin: 10px 0 0; padding: 0; list-style: none;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 9px;
    font-size: 12.5px; color: rgba(255,255,255,0.8);
  }
  .plans__features li { display: flex; align-items: flex-start; gap: 9px; }
  .plans__bullet { flex-shrink: 0; margin-top: 5px; width: 5px; height: 5px; border-radius: 50%; background: #00D2FF; }

  .plans__cta {
    margin-top: auto; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    border-radius: 999px; background: #fff; color: #000; font-weight: 500; font-size: 13.5px;
    padding: 14px 22px; transition: all 0.2s;
  }
  .plans__cta:hover { background: rgba(255,255,255,0.9); color: #000; }
  .plans__cta:active { transform: scale(0.98); }

  @media (max-width: 900px) {
    .plans__grid { grid-template-columns: minmax(0, 1fr); }
    .plans__panel { border-radius: 32px; padding: 26px 22px; }
  }
  @media (max-width: 520px) {
    .plans__option { padding: 16px 18px; border-radius: 22px; }
    .plans__features { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLElement>('[data-plan-btn]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-plan-panel]'));

  const select = (n: string) => {
    buttons.forEach((b) => {
      const on = b.dataset.planBtn === n;
      b.dataset.on = String(on);
      b.setAttribute('aria-checked', String(on));
    });
    panels.forEach((p) => (p.dataset.on = String(p.dataset.planPanel === n)));
  };

  buttons.forEach((b) => {
    b.addEventListener('click', () => select(b.dataset.planBtn ?? '0'));
    b.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      e.preventDefault();
      const i = buttons.indexOf(b);
      const next = buttons[(i + (e.key === 'ArrowDown' ? 1 : buttons.length - 1)) % buttons.length];
      next.focus();
      select(next.dataset.planBtn ?? '0');
    });
  });
</script>
