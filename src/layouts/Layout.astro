---
import '../styles/global.css';
import '../styles/states.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SIMAV Vial · Inteligencia vial con IA',
  description = 'Convertimos los viajes que ya ocurren en tu ciudad en un inventario vial continuo y georreferenciado: baches, grietas y hundimientos detectados y priorizados por severidad.'
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/logo-simav-mark.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
